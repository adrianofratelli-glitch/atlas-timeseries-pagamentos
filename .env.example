# ===== MongoDB Atlas =====
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/?retryWrites=true&w=majority
MONGODB_DB=energia_medicao

# ===== Time series =====
# Fixado na criação da coleção. Não muda depois — ver docs/adr/0001-bucketing.md.
TS_BUCKET_MAX_SPAN_SECONDS=86400
TS_BUCKET_ROUNDING_SECONDS=86400
TS_EXPIRE_AFTER_SECONDS=34560000
TS_MAX_TIME_MS=15000
TS_MAX_RANGE_DAYS=90
TS_MAX_POINTS=4000

# ===== Detecção de perda não técnica =====
LOSS_THRESHOLD_PCT=10
LOSS_MIN_WINDOWS=6

# ===== Geração de dados =====
METERS=20000
DAYS=30
READING_INTERVAL_MINUTES=15
SEED=42

# ===== Ingestão ao vivo (botão play) =====
# TTL curto: o dado ao vivo some sozinho e o roteiro pode rodar de novo.
LIVE_TTL_SECONDS=3600
LIVE_TICK_SECONDS=1.0
LIVE_MINUTES_PER_TICK=30

# ===== Ciclo de vida =====
# Online Archive / Data Federation exigem tier dedicado.
ARCHIVE_ENABLED=false
FEDERATED_URI=

# ===== App =====
BACKEND_PORT=8400
FRONTEND_PORT=5400
LOG_LEVEL=INFO

# ===== Caso de negócio =====
# NÃO são medições: são os números do cliente, e a tela os rotula como tais.
KWH_TARIFF=0.78
FIELD_INSPECTION_COST=180
CURRENCY=R$
